---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { postsByCategory } from '../../utils/blog';

const groups = (await postsByCategory()).filter((group) => group.posts.length > 0);
const total = groups.reduce((count, group) => count + group.posts.length, 0);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章归档 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.archive-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--color-border);
			}

			.archive-title {
				margin: 0 0 0.5rem 0;
				font-size: 1.85rem;
			}

			.archive-desc {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 0.95rem;
			}

			.group-section {
				margin-bottom: 2.5rem;
			}

			.group-title {
				font-size: 1.35rem;
				font-weight: 700;
				color: var(--color-text-dim);
				margin: 0 0 1.25rem 0;
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.group-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background-color: var(--color-border);
			}

			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.post-item {
				position: relative;
				padding: 1rem 1.2rem;
				border-radius: 8px;
				background-color: var(--color-surface);
				border: 1px solid var(--color-border);
				transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
			}

			.post-item:hover {
				border-color: var(--color-accent);
				box-shadow: var(--shadow-card);
				transform: translateY(-1px);
			}

			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.4rem;
				font-size: 0.85rem;
				color: var(--color-text-dim);
				font-family: var(--font-mono);
			}

			.post-title {
				margin: 0 0 0.45rem 0;
				font-size: 1.15rem;
				line-height: 1.4;
			}

			.post-title a {
				color: var(--color-text-main);
				text-decoration: none;
			}

			.post-title a:hover {
				color: var(--color-accent);
			}

			.post-desc {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 0.9rem;
				line-height: 1.6;
			}

			@media (max-width: 640px) {
				.post-item {
					padding: 0.85rem 1rem;
				}
				.post-title {
					font-size: 1.05rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-header">
				<h1 class="archive-title">文章归档</h1>
				<p class="archive-desc">
					共 {total} 篇技术笔记与随笔。文字优先，记录系统设计、算法实验与实践反思。
				</p>
			</section>

			{
				groups.map((group) => (
					<section class="group-section">
						<h2 class="group-title">{group.category.label}</h2>
						<ul class="post-list">
							{group.posts.map((post) => (
								<li class="post-item">
									<div class="post-meta">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3 class="post-title">
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h3>
									{post.data.description && (
										<p class="post-desc">{post.data.description}</p>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
