---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { postsByCategory } from '../../utils/blog';

const groups = (await postsByCategory()).filter((group) => group.posts.length > 0);
const total = groups.reduce((count, group) => count + group.posts.length, 0);

// 每个分类先只展示这么多，其余藏起来由 View all 展开。
const COLLAPSED_COUNT = 3;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章归档 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.archive-header {
				margin-bottom: 2.5rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--color-border);
			}

			.archive-title {
				margin: 0 0 0.5rem 0;
				font-size: 1.85rem;
			}

			.archive-desc {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 0.95rem;
			}

			.group-section {
				margin-bottom: 2.5rem;
			}

			.group-title {
				font-size: 1.35rem;
				font-weight: 700;
				color: var(--color-text-dim);
				margin: 0 0 1.25rem 0;
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.group-title::after {
				content: '';
				flex: 1;
				height: 1px;
				background-color: var(--color-border);
			}

			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}

			.post-item {
				position: relative;
				padding: 1rem 1.2rem;
				border-radius: 8px;
				background-color: var(--color-surface);
				border: 1px solid var(--color-border);
				transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
			}

			.post-item:hover {
				border-color: var(--color-accent);
				box-shadow: var(--shadow-card);
				transform: translateY(-1px);
			}

			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.4rem;
				font-size: 0.85rem;
				color: var(--color-text-dim);
				font-family: var(--font-mono);
			}

			.post-title {
				margin: 0 0 0.45rem 0;
				font-size: 1.15rem;
				line-height: 1.4;
			}

			.post-title a {
				color: var(--color-text-main);
				text-decoration: none;
			}

			.post-title a:hover {
				color: var(--color-accent);
			}

			.post-desc {
				margin: 0;
				color: var(--color-text-muted);
				font-size: 0.9rem;
				line-height: 1.6;
			}

			.group-count {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 400;
				color: var(--color-text-dim);
			}

			.view-all {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				margin-top: 1rem;
				padding: 0.4rem 0.9rem;
				border: 1px solid var(--color-border);
				border-radius: 999px;
				background: var(--color-surface);
				color: var(--color-text-muted);
				font-family: var(--font-mono);
				font-size: 0.78rem;
				cursor: pointer;
				transition: border-color 0.15s ease, color 0.15s ease;
			}

			.view-all:hover {
				border-color: var(--color-accent);
				color: var(--color-accent);
			}

			.view-all-chevron {
				transition: transform 0.18s ease;
			}

			.view-all.is-open .view-all-chevron {
				transform: rotate(180deg);
			}

			.view-all-more {
				color: var(--color-text-dim);
			}

			@media (max-width: 640px) {
				.post-item {
					padding: 0.85rem 1rem;
				}
				.post-title {
					font-size: 1.05rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-header">
				<h1 class="archive-title">文章归档</h1>
				<p class="archive-desc">
					共 {total} 篇技术笔记与随笔。文字优先，记录系统设计、算法实验与实践反思。
				</p>
			</section>

			{
				groups.map((group) => (
					<section class="group-section" data-keep={COLLAPSED_COUNT}>
						<h2 class="group-title">
								{group.category.label}
								<span class="group-count">{group.posts.length}</span>
							</h2>
						<ul class="post-list">
							{group.posts.map((post, index) => (
								<li class="post-item" hidden={index >= COLLAPSED_COUNT}>
									<div class="post-meta">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3 class="post-title">
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h3>
									{post.data.description && (
										<p class="post-desc">{post.data.description}</p>
									)}
								</li>
							))}
						</ul>
						{group.posts.length > COLLAPSED_COUNT && (
							<button class="view-all" type="button" hidden>
								<svg class="view-all-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
								<span class="view-all-text">View all</span>
								<span class="view-all-more">+{group.posts.length - COLLAPSED_COUNT}</span>
							</button>
						)}
					</section>
				))
			}
		</main>
		<Footer />
		<script>
			(() => {
				// 分类下超过 data-keep 篇的部分默认收起，由 View all 展开。
				// 按钮本身在 HTML 里是 hidden 的，无 JS 时不会出现一个点不动的按钮。
				document.querySelectorAll<HTMLElement>('.view-all').forEach((button) => {
					const section = button.closest<HTMLElement>('.group-section');
					if (!section) return;

					const keep = Number(section.dataset.keep ?? 3);
					const extras = Array.from(
						section.querySelectorAll<HTMLElement>(`.post-item:nth-child(n + ${keep + 1})`),
					);
					if (extras.length === 0) return;

					const text = button.querySelector('.view-all-text');
					const more = button.querySelector('.view-all-more');
					button.hidden = false;
					button.setAttribute('aria-expanded', 'false');

					button.addEventListener('click', () => {
						const expanded = button.getAttribute('aria-expanded') === 'true';
						extras.forEach((item) => {
							item.hidden = expanded;
						});
						button.setAttribute('aria-expanded', expanded ? 'false' : 'true');
						button.classList.toggle('is-open', !expanded);
						if (text) text.textContent = expanded ? 'View all' : '收起';
						if (more) more.hidden = !expanded;
						if (expanded) section.scrollIntoView({ block: 'start' });
					});
				});
			})();
		</script>
	</body>
</html>
