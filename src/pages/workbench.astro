---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, WORKBENCH_PUBLIC_DEFAULT } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`Workbench · ${SITE_TITLE}`}
			description="个人工作台：博客管理、项目工程看板、学术研读与实验备忘"
		/>
		<style>
			.workbench-wrapper {
				max-width: 54rem;
				margin: 0 auto;
			}

			/* Top Status & Capsule Bar */
			.top-control-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px dashed var(--color-border);
				margin-bottom: 2rem;
			}

			.control-left {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: var(--color-text-dim);
			}

			.live-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: #10b981;
				box-shadow: 0 0 6px #10b981;
			}

			.capsule-toggle {
				display: inline-flex;
				align-items: center;
				background: var(--color-surface-hover);
				border: 1px solid var(--color-border);
				border-radius: 999px;
				padding: 2px;
				cursor: pointer;
				user-select: none;
			}

			.capsule-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.25rem 0.75rem;
				border-radius: 999px;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--color-text-dim);
				transition: all 0.15s ease;
			}

			.capsule-btn.active {
				background: var(--color-text-main);
				color: var(--color-bg);
				font-weight: 600;
			}

			/* Workbench Layout */
			.workbench-layout {
				display: flex;
				gap: 2rem;
				align-items: flex-start;
			}

			/* Collapsible Sidebar */
			.wb-sidebar {
				width: 200px;
				flex-shrink: 0;
				position: sticky;
				top: 5rem;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				transition: width 0.2s ease;
			}

			.wb-sidebar.collapsed {
				width: 48px;
			}

			.sidebar-head-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 0.5rem;
			}

			.sidebar-title {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				font-weight: 700;
				color: var(--color-text-dim);
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			.wb-sidebar.collapsed .sidebar-title {
				display: none;
			}

			.collapse-trigger {
				background: transparent;
				border: none;
				color: var(--color-text-dim);
				cursor: pointer;
				padding: 2px;
				display: flex;
				align-items: center;
			}

			.collapse-trigger:hover {
				color: var(--color-text-main);
			}

			.wb-nav {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}

			.wb-nav-link {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.45rem 0.5rem;
				border-radius: 6px;
				color: var(--color-text-muted);
				text-decoration: none;
				font-size: 0.9rem;
				transition: all 0.15s ease;
			}

			.wb-nav-link:hover {
				color: var(--color-text-main);
				background: var(--color-surface-hover);
				text-decoration: none;
			}

			.wb-nav-link.active {
				color: var(--color-accent);
				font-weight: 600;
			}

			.nav-text-group {
				display: flex;
				align-items: center;
				gap: 0.6rem;
			}

			.wb-sidebar.collapsed .nav-label,
			.wb-sidebar.collapsed .nav-count {
				display: none;
			}

			.nav-count {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-text-dim);
			}

			/* Main View */
			.wb-content {
				flex: 1;
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}

			/* Terminal Lock View */
			.terminal-lock-box {
				display: none;
				border: 1px solid var(--color-border);
				border-radius: 8px;
				padding: 2rem;
				background: var(--color-surface);
				font-family: var(--font-mono);
				margin: 2rem 0;
			}

			.lock-log {
				font-size: 0.85rem;
				color: var(--color-text-muted);
				line-height: 1.7;
				margin-bottom: 1.5rem;
			}

			/* Panel Section */
			.wb-section {
				scroll-margin-top: 5rem;
			}

			.section-lead {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 1rem;
			}

			.section-lead-title {
				font-size: 1.15rem;
				font-weight: 700;
				margin: 0;
			}

			.section-lead-tag {
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-text-dim);
			}

			/* Blog Table Style */
			.wb-table {
				width: 100%;
				border-collapse: collapse;
			}

			.wb-table th {
				font-family: var(--font-mono);
				font-size: 0.76rem;
				color: var(--color-text-dim);
				padding: 0.5rem 0;
				border-bottom: 1px solid var(--color-border);
				text-align: left;
			}

			.wb-table td {
				padding: 0.75rem 0;
				border-bottom: 1px dashed var(--color-border);
				font-size: 0.9rem;
			}

			.wb-table tr:hover td {
				background: var(--color-surface-hover);
			}

			/* Projects Bento Style */
			.wb-project-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1rem;
			}

			.wb-card {
				border: 1px solid var(--color-border);
				border-radius: 8px;
				padding: 1rem;
				background: var(--color-surface);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 0.6rem;
				transition: border-color 0.15s ease;
			}

			.wb-card:hover {
				border-color: var(--color-accent);
			}

			.wb-card-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.wb-card-title {
				font-weight: 600;
				font-size: 0.98rem;
				color: var(--color-text-main);
				text-decoration: none;
			}

			.wb-card-desc {
				font-size: 0.85rem;
				color: var(--color-text-muted);
				margin: 0;
				line-height: 1.5;
			}

			/* Talks / Papers in pseudoyu format */
			.talk-row {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.75rem;
				padding: 0.75rem 0;
				border-bottom: 1px dashed var(--color-border);
			}

			.talk-meta-dim {
				font-size: 0.8rem;
				font-family: var(--font-mono);
				color: var(--color-text-dim);
			}

			/* Lab Scratchpad */
			.notes-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 0.85rem;
			}

			.note-box {
				border: 1px dashed var(--color-border);
				border-radius: 6px;
				padding: 0.85rem;
				font-size: 0.85rem;
			}

			.note-box-title {
				font-family: var(--font-mono);
				font-weight: 700;
				font-size: 0.78rem;
				color: var(--color-text-dim);
				text-transform: uppercase;
				margin-bottom: 0.35rem;
			}

			@media (max-width: 768px) {
				.workbench-layout {
					flex-direction: column;
				}

				.wb-sidebar {
					width: 100% !important;
					position: static;
				}

				.wb-nav {
					flex-direction: row;
					flex-wrap: wrap;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="workbench-wrapper">
				<!-- Top HUD Control Bar (pseudoyu clean minimal) -->
				<div class="top-control-bar">
					<div class="control-left">
						<span class="live-dot"></span>
						<span>ruyishu@lab:~/workbench</span>
						<span>·</span>
						<span id="access-status-text">COLLAPSED</span>
					</div>

					<div class="control-right">
						<div class="capsule-toggle" id="visibility-capsule" role="switch" title="切换收起/展开">
							<span class="capsule-btn active" id="opt-private">收起</span>
							<span class="capsule-btn" id="opt-public">展开</span>
						</div>
					</div>
				</div>

				<div class="workbench-layout">
					<!-- 左侧收缩侧边栏 -->
					<aside class="wb-sidebar" id="wb-sidebar">
						<div class="sidebar-head-row">
							<span class="sidebar-title">Sections</span>
							<button class="collapse-trigger" id="sidebar-collapse-btn" type="button" title="折叠侧边栏">
								<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
							</button>
						</div>

						<ul class="wb-nav">
							<li>
								<a href="#blog" class="wb-nav-link active" data-target="blog">
									<div class="nav-text-group">
										<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
										<span class="nav-label">博客内容</span>
									</div>
									<span class="nav-count">{posts.length}</span>
								</a>
							</li>
							<li>
								<a href="#projects" class="wb-nav-link" data-target="projects">
									<div class="nav-text-group">
										<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M13 6h3a2 2 0 0 1 2 2v7"></path><line x1="6" y1="9" x2="6" y2="21"></line></svg>
										<span class="nav-label">项目仓库</span>
									</div>
									<span class="nav-count">0</span>
								</a>
							</li>
							<li>
								<a href="#papers" class="wb-nav-link" data-target="papers">
									<div class="nav-text-group">
										<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
										<span class="nav-label">论文学术</span>
									</div>
									<span class="nav-count">0</span>
								</a>
							</li>
							<li>
								<a href="#notes" class="wb-nav-link" data-target="notes">
									<div class="nav-text-group">
										<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"></path><path d="M8.5 2h7"></path><path d="M7 16h10"></path></svg>
										<span class="nav-label">实验备忘</span>
									</div>
									<span class="nav-count">0</span>
								</a>
							</li>
						</ul>
					</aside>

					<!-- 主体内容区 -->
					<div class="wb-content">
						<!-- 极简终端锁屏界面 -->
						<div class="terminal-lock-box" id="locked-view">
							<div class="lock-log">
								<span>$ access-control --status</span><br />
								<span style="color: var(--color-accent);">[COLLAPSED] 工作台默认收起，内容未直接展示。</span>
							</div>

							<p style="margin: 0.75rem 0 0 0; font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-text-dim);">
								工作台默认收起，用右上角开关展开查看。
							</p>
						</div>

						<!-- 四大工作板块 -->
						<div id="unlocked-dashboard" style="display: flex; flex-direction: column; gap: 2.5rem;">
							<!-- 板块 1: 博客文章 -->
							<section class="wb-section" id="blog">
								<div class="section-lead">
									<h2 class="section-lead-title">01 // 博客文章与内容库</h2>
									<span class="section-lead-tag">Astro Content Collections</span>
								</div>
								<table class="wb-table">
									<thead>
										<tr>
											<th>Title / Path</th>
											<th>Date</th>
											<th>Action</th>
										</tr>
									</thead>
									<tbody>
										{
											posts.map((post) => (
												<tr>
													<td>
														<a href={`/blog/${post.id}/`} style="font-weight: 600; text-decoration: none;">
															{post.data.title}
														</a>
														<div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text-dim);">
															src/content/blog/{post.id}.md
														</div>
													</td>
													<td style="font-family: var(--font-mono); color: var(--color-text-dim);">
														<FormattedDate date={post.data.pubDate} />
													</td>
													<td>
														<a href={`/blog/${post.id}/`} style="color: var(--color-accent); font-family: var(--font-mono); font-size: 0.8rem;">
															查看
														</a>
													</td>
												</tr>
											))
										}
									</tbody>
								</table>
							</section>

							<!-- 板块 2: 项目仓库 -->
							<section class="wb-section" id="projects">
								<div class="section-lead">
									<h2 class="section-lead-title">02 // 项目工程追踪</h2>
									<span class="section-lead-tag">Repositories</span>
								</div>
								<!-- 加项目：外套一个 wb-project-grid，里面每个项目一个 wb-card -->
								<p style="margin: 0; font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-text-dim);">
									暂无记录。
								</p>
							</section>

							<!-- 板块 3: 论文学术 -->
							<section class="wb-section" id="papers">
								<div class="section-lead">
									<h2 class="section-lead-title">03 // 学术成果与预印本雷达</h2>
									<span class="section-lead-tag">Publications</span>
								</div>

								<!-- 加论文：每条一个 talk-row，里面放标题、标签和 meta -->
								<p style="margin: 0; font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-text-dim);">
									暂无记录。
								</p>
							</section>

							<!-- 板块 4: 实验备忘与待办 -->
							<section class="wb-section" id="notes">
								<div class="section-lead">
									<h2 class="section-lead-title">04 // 实验记录与极客备忘</h2>
									<span class="section-lead-tag">Lab Scratchpad</span>
								</div>

								<!-- 加备忘：每个卡片一个 note-box -->
								<p style="margin: 0; font-family: var(--font-mono); font-size: 0.85rem; color: var(--color-text-dim);">
									暂无记录。
								</p>
							</section>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />

		<script is:inline define:vars={{ defaultPublic: WORKBENCH_PUBLIC_DEFAULT }}>
			(() => {
				const sidebar = document.getElementById('wb-sidebar');
				const collapseBtn = document.getElementById('sidebar-collapse-btn');
				const capsuleSwitch = document.getElementById('visibility-capsule');
				const optPrivate = document.getElementById('opt-private');
				const optPublic = document.getElementById('opt-public');
				const lockedView = document.getElementById('locked-view');
				const unlockedDashboard = document.getElementById('unlocked-dashboard');
				const statusText = document.getElementById('access-status-text');

				// 折叠侧边栏
				if (collapseBtn && sidebar) {
					collapseBtn.addEventListener('click', () => {
						const isCollapsed = sidebar.classList.toggle('collapsed');
						try {
							localStorage.setItem('workbench_sidebar_collapsed', isCollapsed ? 'true' : 'false');
						} catch (e) {}
					});

					try {
						if (localStorage.getItem('workbench_sidebar_collapsed') === 'true') {
							sidebar.classList.add('collapsed');
						}
					} catch (e) {}
				}

				// 显示状态：只由浏览器本地开关控制，不参与任何访问控制
				function getIsPublic() {
					try {
						const saved = localStorage.getItem('ruyishu_workbench_is_public');
						if (saved !== null) return saved === 'true';
					} catch (e) {}
					return defaultPublic;
				}

				function updateUI() {
					const isPublic = getIsPublic();

					if (isPublic) {
						optPublic?.classList.add('active');
						optPrivate?.classList.remove('active');
						if (statusText) {
							statusText.textContent = 'EXPANDED';
							statusText.style.color = '#10b981';
						}
					} else {
						optPrivate?.classList.add('active');
						optPublic?.classList.remove('active');
						if (statusText) {
							statusText.textContent = 'COLLAPSED';
							statusText.style.color = 'var(--color-text-dim)';
						}
					}

					if (isPublic) {
						if (lockedView) lockedView.style.display = 'none';
						if (unlockedDashboard) unlockedDashboard.style.display = 'flex';
					} else {
						if (lockedView) lockedView.style.display = 'block';
						if (unlockedDashboard) unlockedDashboard.style.display = 'none';
					}
				}

				if (capsuleSwitch) {
					capsuleSwitch.addEventListener('click', () => {
						const current = getIsPublic();
						const next = !current;
						try {
							localStorage.setItem('ruyishu_workbench_is_public', next ? 'true' : 'false');
						} catch (e) {}
						updateUI();
					});
				}

				// 导航高亮联动
				const navLinks = document.querySelectorAll('.wb-nav-link');
				function updateHash() {
					const hash = window.location.hash.replace('#', '');
					if (hash) {
						navLinks.forEach((link) => {
							if (link.getAttribute('data-target') === hash) {
								link.classList.add('active');
							} else {
								link.classList.remove('active');
							}
						});
					}
				}

				window.addEventListener('hashchange', updateHash);
				updateHash();
				updateUI();
			})();
		</script>
	</body>
</html>
