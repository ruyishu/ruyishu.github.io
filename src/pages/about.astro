---
import AccessLocked from '../components/AccessLocked.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { PAGE_ACCESS, SITE_TITLE } from '../consts';
import { EDUCATION, EXPERIENCES, LINKS, METRICS, PROFILE, PROJECTS, SKILLS } from '../data/resume';

// 关闭时整个 deck 不参与构建输出，只留下锁页。
const open = PAGE_ACCESS.about;

const slides = [
	{ id: 'intro', label: '概览' },
	{ id: 'experience', label: '经历' },
	...PROJECTS.map((project) => ({ id: project.slug, label: project.navLabel })),
	{ id: 'skills', label: '技能' },
	{ id: 'contact', label: '联系' },
];

const slideNumber = (id: string) => String(slides.findIndex((slide) => slide.id === id) + 1).padStart(2, '0');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_TITLE}`} description="如意鼠 · 大模型算法工程师：训练与后训练、蒸馏与评测、多模态推理" />
		<style>
			main {
				max-width: 62rem;
				padding: 2rem 1.5rem 5rem 1.5rem;
			}

			/* ---------- 顶部/底部演示控件 ---------- */
			.deck-progress {
				position: fixed;
				left: 0;
				bottom: 0;
				width: 100%;
				height: 2px;
				background: var(--color-border-subtle);
				z-index: 60;
			}

			.deck-progress-bar {
				display: block;
				height: 100%;
				width: 0;
				background: var(--color-accent);
				transition: width 0.25s ease;
			}

			.deck-rail {
				position: fixed;
				right: 1.5rem;
				top: 50%;
				transform: translateY(-50%);
				z-index: 40;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				align-items: flex-end;
			}

			.deck-dot {
				display: flex;
				align-items: center;
				gap: 0.55rem;
				background: none;
				border: none;
				padding: 0;
				cursor: pointer;
				color: var(--color-text-dim);
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.02em;
			}

			.deck-dot-label {
				opacity: 0;
				transform: translateX(4px);
				transition: opacity 0.18s ease, transform 0.18s ease;
				white-space: nowrap;
			}

			.deck-dot:hover .deck-dot-label,
			.deck-dot.active .deck-dot-label {
				opacity: 1;
				transform: none;
			}

			.deck-dot-mark {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				border: 1px solid var(--color-text-dim);
				transition: background 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
			}

			.deck-dot.active .deck-dot-mark {
				background: var(--color-accent);
				border-color: var(--color-accent);
				transform: scale(1.35);
			}

			.deck-counter {
				position: fixed;
				right: 3.25rem;
				bottom: 1.25rem;
				z-index: 40;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--color-text-dim);
				letter-spacing: 0.08em;
			}

			/* ---------- 幻灯片 ---------- */
			.slide {
				min-height: calc(100svh - 9rem);
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: 3.5rem 0;
				scroll-margin-top: 5rem;
			}

			.slide.is-visible > * {
				animation: slide-enter 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
			}

			.slide.is-visible > *:nth-child(2) {
				animation-delay: 0.05s;
			}

			.slide.is-visible > *:nth-child(3) {
				animation-delay: 0.1s;
			}

			.slide.is-visible > *:nth-child(4) {
				animation-delay: 0.15s;
			}

			.slide.is-visible > *:nth-child(n + 5) {
				animation-delay: 0.2s;
			}

			.slide + .slide {
				border-top: 1px dashed var(--color-border);
			}

			/* ---------- 封面 ---------- */
			.slide-eyebrow {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--color-text-dim);
				margin-bottom: 1.5rem;
			}

			.live-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: #10b981;
				box-shadow: 0 0 6px #10b981;
			}

			.hero-name {
				font-size: 4rem;
				font-weight: 800;
				letter-spacing: -0.04em;
				line-height: 1.05;
				margin: 0 0 0.75rem 0;
			}

			.hero-role {
				font-size: 1.5rem;
				font-weight: 600;
				color: var(--color-text-main);
				letter-spacing: -0.01em;
			}

			.hero-tagline {
				margin: 0.65rem 0 0 0;
				font-family: var(--font-mono);
				font-size: 0.9rem;
				color: var(--color-accent);
			}

			.hero-bio {
				max-width: 44rem;
				margin-top: 1.75rem;
			}

			.hero-bio p {
				font-size: 1rem;
				color: var(--color-text-muted);
				margin-bottom: 0.85rem;
			}

			.hero-hint {
				margin-top: 2rem;
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: var(--color-text-dim);
			}

			/* ---------- 指标卡 ---------- */
			.metric-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
				gap: 0.75rem;
				margin: 2rem 0 0 0;
			}

			.metric-card {
				border: 1px solid var(--color-border);
				border-radius: 8px;
				padding: 0.9rem 1rem;
				background: var(--color-surface);
			}

			.metric-value {
				display: block;
				font-size: 1.55rem;
				font-weight: 800;
				letter-spacing: -0.03em;
				color: var(--color-text-main);
				line-height: 1.2;
			}

			.metric-label {
				display: block;
				margin-top: 0.35rem;
				font-size: 0.78rem;
				line-height: 1.5;
				color: var(--color-text-dim);
			}

			/* ---------- 幻灯片标题 ---------- */
			.slide-head {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.75rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 1.25rem;
			}

			.slide-index {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--color-accent);
			}

			.slide-head h2 {
				margin: 0;
				font-size: 1.6rem;
				letter-spacing: -0.02em;
			}

			.slide-tag {
				margin-left: auto;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--color-text-dim);
			}

			.slide-sub {
				max-width: 48rem;
				font-size: 0.98rem;
				color: var(--color-text-muted);
				margin-bottom: 1.25rem;
			}

			/* ---------- 时间线 ---------- */
			.timeline {
				display: flex;
				flex-direction: column;
			}

			.tl-item {
				display: grid;
				grid-template-columns: 9rem 1fr;
				gap: 1.5rem;
				padding: 1.25rem 0;
				border-bottom: 1px dashed var(--color-border);
			}

			.tl-period {
				font-family: var(--font-mono);
				font-size: 0.78rem;
				color: var(--color-text-dim);
				padding-top: 0.2rem;
			}

			.tl-body h3 {
				margin: 0 0 0.2rem 0;
				font-size: 1.05rem;
			}

			.tl-role {
				font-size: 0.85rem;
				color: var(--color-accent);
				margin-bottom: 0.6rem;
			}

			/* ---------- 通用列表 ---------- */
			.bullet-list {
				margin: 0;
				padding: 0;
				list-style: none;
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
			}

			.bullet-list li {
				position: relative;
				padding-left: 1.1rem;
				font-size: 0.93rem;
				line-height: 1.75;
				color: var(--color-text-muted);
			}

			.bullet-list li::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0.72rem;
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background: var(--color-border);
				border: 1px solid var(--color-text-dim);
			}

			/* ---------- 标签 ---------- */
			.tag-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 1rem;
			}

			.tag {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				padding: 0.15rem 0.5rem;
				border: 1px solid var(--color-border);
				border-radius: 999px;
				color: var(--color-text-dim);
				background: var(--color-surface);
			}

			.todo-chip {
				display: inline-block;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				padding: 0.1rem 0.45rem;
				border-radius: 999px;
				border: 1px dashed #d97706;
				color: #b45309;
				background: rgba(217, 119, 6, 0.08);
				vertical-align: middle;
			}

			:global(html[data-theme='dark']) .todo-chip {
				color: #fbbf24;
				border-color: #b45309;
			}

			@media (prefers-color-scheme: dark) {
				:global(html:not([data-theme='light'])) .todo-chip {
					color: #fbbf24;
					border-color: #b45309;
				}
			}

			/* ---------- 教育 ---------- */
			.edu-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}

			.edu-card {
				flex: 1 1 14rem;
				border: 1px solid var(--color-border);
				border-radius: 8px;
				padding: 0.9rem 1rem;
				background: var(--color-surface);
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}

			.edu-school {
				font-weight: 700;
				font-size: 1rem;
			}

			.edu-degree {
				font-size: 0.82rem;
				color: var(--color-text-muted);
			}

			/* ---------- 技能 ---------- */
			.skill-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
				gap: 0.75rem;
			}

			.skill-card {
				border: 1px solid var(--color-border);
				border-radius: 8px;
				padding: 1rem 1.1rem;
				background: var(--color-surface);
			}

			.skill-card h3 {
				font-family: var(--font-mono);
				font-size: 0.76rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--color-text-dim);
				margin: 0 0 0.6rem 0;
			}

			.skill-card ul {
				margin: 0;
				padding: 0;
				list-style: none;
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
			}

			.skill-card li {
				font-size: 0.86rem;
				line-height: 1.6;
				color: var(--color-text-muted);
			}

			/* ---------- 联系 ---------- */
			.contact-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
				gap: 0.75rem;
			}

			.contact-card {
				border: 1px solid var(--color-border);
				border-radius: 8px;
				padding: 1rem 1.1rem;
				background: var(--color-surface);
				text-decoration: none;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				transition: border-color 0.15s ease, transform 0.15s ease;
			}

			.contact-card:hover {
				border-color: var(--color-accent);
				transform: translateY(-2px);
				text-decoration: none;
			}

			.contact-label {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--color-text-dim);
			}

			.contact-value {
				font-size: 0.92rem;
				color: var(--color-text-main);
				font-weight: 600;
			}

			.closing {
				margin-top: 2rem;
				font-size: 0.9rem;
				color: var(--color-text-dim);
			}

			/* ---------- 响应式 ---------- */
			@media (max-width: 1100px) {
				.deck-rail {
					display: none;
				}

				.deck-counter {
					right: 1.25rem;
				}
			}

			@media (max-width: 640px) {
				main {
					padding: 1.5rem 1.1rem 4rem 1.1rem;
				}

				.slide {
					min-height: auto;
					padding: 2.5rem 0;
				}

				.hero-name {
					font-size: 2.6rem;
				}

				.hero-role {
					font-size: 1.2rem;
				}

				.tl-item {
					grid-template-columns: 1fr;
					gap: 0.5rem;
				}
			}

			/* ---------- 打印 / 导出 PDF ---------- */
			@media print {
				.deck-rail,
				.deck-counter,
				.deck-progress {
					display: none !important;
				}

				main {
					max-width: none;
					padding: 0;
				}

				.slide {
					min-height: auto;
					padding: 0.75rem 0;
					break-inside: avoid;
					page-break-inside: avoid;
				}

				.slide + .slide {
					border-top: 1px solid var(--color-border);
				}

				.metric-card,
				.skill-card,
				.contact-card,
				.edu-card {
					break-inside: avoid;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		{open && (
		<div class="deck-progress"><span class="deck-progress-bar" id="deck-progress-bar"></span></div>
		<div class="deck-counter" id="deck-counter">01 / {String(slides.length).padStart(2, '0')}</div>

		<nav class="deck-rail" id="deck-rail" aria-label="页面导航">
			{
				slides.map((slide, index) => (
					<button
						type="button"
						class={`deck-dot${index === 0 ? ' active' : ''}`}
						data-target={slide.id}
						aria-label={slide.label}
					>
						<span class="deck-dot-label">{slide.label}</span>
						<span class="deck-dot-mark" />
					</button>
				))
			}
		</nav>
		)}

		<main>
			{open ? (
				<>
			<!-- 封面 -->
			<section class="slide is-visible" id="intro">
				<div class="slide-eyebrow">
					<span class="live-dot"></span>
					<span>ruyishu@lab:~$ whoami</span>
				</div>

				<h1 class="hero-name">{PROFILE.name}</h1>
				<div class="hero-role">{PROFILE.role}</div>
				<div class="hero-tagline">{PROFILE.tagline}</div>

				<div class="hero-bio">
					{PROFILE.bio.map((paragraph) => <p>{paragraph}</p>)}
				</div>

				<div class="metric-grid">
					{
						METRICS.map((metric) => (
							<div class="metric-card">
								<span class="metric-value">{metric.value}</span>
								<span class="metric-label">{metric.label}</span>
							</div>
						))
					}
				</div>

				<div class="hero-hint">{PROFILE.hint}</div>
			</section>

			<!-- 经历 -->
			<section class="slide" id="experience">
				<div class="slide-head">
				<span class="slide-index">{slideNumber('experience')}</span>
					<h2>经历</h2>
					<span class="slide-tag">Experience</span>
				</div>

				<div class="timeline">
					{
						EXPERIENCES.map((experience) => (
							<article class="tl-item">
								<div class="tl-period">
									{experience.period}
									{experience.needsInput && <span class="todo-chip">时间待补充</span>}
								</div>
								<div class="tl-body">
									<h3>{experience.org}</h3>
									<div class="tl-role">{experience.role}</div>
									<ul class="bullet-list">
										{experience.bullets.map((bullet) => (
											<li>{bullet}</li>
										))}
									</ul>
									{experience.tags && (
										<div class="tag-row">
											{experience.tags.map((tag) => (
												<span class="tag">{tag}</span>
											))}
										</div>
									)}
								</div>
							</article>
						))
					}
				</div>

				<div class="edu-row">
					{
						EDUCATION.map((education) => (
							<div class="edu-card">
								<span class="edu-school">{education.school}</span>
								<span class="edu-degree">
									{education.degree}
									{education.period && ` · ${education.period}`}
									{education.needsInput && <span class="todo-chip">年份待补充</span>}
								</span>
							</div>
						))
					}
				</div>
			</section>

			<!-- 项目 -->
			{
				PROJECTS.map((project) => (
					<section class="slide" id={project.slug}>
						<div class="slide-head">
							<span class="slide-index">{slideNumber(project.slug)}</span>
							<h2>{project.title}</h2>
							<span class="slide-tag">{project.kicker}</span>
						</div>

						<p class="slide-sub">
							{project.subtitle} {project.needsInput && <span class="todo-chip">待补充</span>}
						</p>

						{project.metrics && (
							<div class="metric-grid">
								{project.metrics.map((metric) => (
									<div class="metric-card">
										<span class="metric-value">{metric.value}</span>
										<span class="metric-label">{metric.label}</span>
									</div>
								))}
							</div>
						)}

						<ul class="bullet-list" style="margin-top: 1.5rem;">
							{project.bullets.map((bullet) => (
								<li>{bullet}</li>
							))}
						</ul>

						<div class="tag-row">
							{project.tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>

						{project.link && (
							<div class="tag-row">
								<a href={project.link.href} target="_blank" rel="noopener noreferrer" style="font-family: var(--font-mono); font-size: 0.85rem;">
									{project.link.label} →
								</a>
							</div>
						)}
					</section>
				))
			}

			<!-- 技能 -->
			<section class="slide" id="skills">
				<div class="slide-head">
					<span class="slide-index">{slideNumber('skills')}</span>
					<h2>技能</h2>
					<span class="slide-tag">Toolbox</span>
				</div>

				<div class="skill-grid">
					{
						SKILLS.map((skill) => (
							<div class="skill-card">
								<h3>{skill.group}</h3>
								<ul>
									{skill.items.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- 联系 -->
			<section class="slide" id="contact">
				<div class="slide-head">
					<span class="slide-index">{slideNumber('contact')}</span>
					<h2>联系</h2>
					<span class="slide-tag">Contact</span>
				</div>

				<div class="contact-grid">
					{
						LINKS.map((link) => (
							<a class="contact-card" href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
								<span class="contact-label">{link.label}</span>
								<span class="contact-value">{link.value}</span>
							</a>
						))
					}
				</div>

				<p class="closing">
					博客里还有 <a href="/blog">43 篇论文阅读与技术复盘</a>，以及按分类归档的<a href="/workbench">工作台</a>。
				</p>
			</section>
		</>
			) : (
				<AccessLocked page="关于" />
			)}
		</main>

		<Footer />

		<script>
			(() => {
				const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
				const dots = Array.from(document.querySelectorAll<HTMLElement>('.deck-dot'));
				const counter = document.getElementById('deck-counter');
				const progressBar = document.getElementById('deck-progress-bar');
				if (slides.length === 0) return;

				let current = 0;

				/* 当前页高亮：以「占视口最多的那一页」为准，滚动与键盘都走这条路径 */
				const setActive = (index: number) => {
					current = Math.max(0, Math.min(slides.length - 1, index));
					dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
					if (counter) {
						counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
					}
				};

				const goTo = (index: number) => {
					const target = slides[Math.max(0, Math.min(slides.length - 1, index))];
					if (!target) return;
					target.scrollIntoView({ behavior: 'smooth', block: 'start' });
					setActive(slides.indexOf(target));
				};

				dots.forEach((dot) => {
					dot.addEventListener('click', () => {
						const id = dot.getAttribute('data-target');
						const target = id ? document.getElementById(id) : null;
						if (target) goTo(slides.indexOf(target as HTMLElement));
					});
				});

				/* 键盘翻页：上下/左右/空格/PageUp·PageDown/Home·End/数字直达 */
				window.addEventListener('keydown', (event) => {
					const tag = (event.target as HTMLElement | null)?.tagName;
					if (tag === 'INPUT' || tag === 'TEXTAREA') return;

					const next = ['ArrowDown', 'ArrowRight', 'PageDown', ' '];
					const prev = ['ArrowUp', 'ArrowLeft', 'PageUp'];

					if (next.includes(event.key)) {
						event.preventDefault();
						goTo(current + 1);
					} else if (prev.includes(event.key)) {
						event.preventDefault();
						goTo(current - 1);
					} else if (event.key === 'Home') {
						event.preventDefault();
						goTo(0);
					} else if (event.key === 'End') {
						event.preventDefault();
						goTo(slides.length - 1);
					} else if (/^[1-9]$/.test(event.key)) {
						const index = Number(event.key) - 1;
						if (index < slides.length) {
							event.preventDefault();
							goTo(index);
						}
					}
				});

				/* 入场动画 + 进度条 + 当前页跟随手动滚动 */
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) entry.target.classList.add('is-visible');
						});
					},
					{ threshold: 0.15 },
				);
				slides.forEach((slide) => observer.observe(slide));

				const onScroll = () => {
					const doc = document.documentElement;
					const scrollable = doc.scrollHeight - window.innerHeight;
					const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
					if (progressBar) progressBar.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;

					/* header 高度下沿取基准线，谁跨过中线谁是当前页 */
					const line = window.innerHeight * 0.4;
					let best = 0;
					let bestDistance = Infinity;
					slides.forEach((slide, i) => {
						const rect = slide.getBoundingClientRect();
						const distance = Math.abs(rect.top - line);
						if (rect.bottom > line && distance < bestDistance) {
							bestDistance = distance;
							best = i;
						}
					});
					setActive(best);
				};

				window.addEventListener('scroll', onScroll, { passive: true });
				onScroll();
			})();
		</script>
	</body>
</html>
