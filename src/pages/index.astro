---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 4);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.content-wrapper {
				max-width: 48rem;
				margin: 0 auto;
			}

			/* Bio Section */
			.intro-section {
				margin-bottom: 2.5rem;
			}

			.author-name {
				font-size: 2.5rem;
				font-weight: 800;
				letter-spacing: -0.03em;
				margin: 0 0 0.5rem 0;
			}

			.author-tagline {
				font-size: 1.15rem;
				color: var(--color-text-muted);
				margin-bottom: 1.5rem;
				line-height: 1.6;
			}

			.bio-paragraph {
				font-size: 1rem;
				line-height: 1.8;
				color: var(--color-text-main);
				margin-bottom: 1rem;
			}

			/* pseudoyu style Subnav Tabs */
			.subnav-tabs {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 1.5rem;
				font-size: 1.6rem;
				font-weight: 700;
				letter-spacing: -0.02em;
				margin: 2rem 0 3rem 0;
				padding-bottom: 0.5rem;
			}

			.subnav-tab {
				color: var(--color-text-main);
				opacity: 0.25;
				text-decoration: none;
				transition: opacity 0.15s ease;
			}

			.subnav-tab:hover {
				opacity: 0.7;
				text-decoration: none;
			}

			.subnav-tab.active {
				opacity: 1;
				text-decoration: underline;
				text-underline-offset: 8px;
			}

			/* pseudoyu Talks Section Style */
			.talks-group {
				margin-bottom: 2.5rem;
			}

			.group-heading {
				font-size: 1.15rem;
				font-weight: 700;
				color: var(--color-text-main);
				margin: 1.5rem 0 0.75rem 0;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.talk-item-row {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
				padding: 0.85rem 0;
				border-bottom: 1px dashed var(--color-border);
				transition: background-color 0.15s ease;
			}

			.talk-item-row:hover {
				background-color: var(--color-surface-hover);
				border-radius: 6px;
				padding-left: 0.5rem;
				padding-right: 0.5rem;
			}

			.talk-left {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				flex: 1;
				min-width: 280px;
			}

			.talk-title-line {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.talk-title-link {
				font-size: 1rem;
				font-weight: 600;
				color: var(--color-text-main);
				text-decoration: none;
			}

			.talk-title-link:hover {
				color: var(--color-accent);
				text-decoration: underline;
			}

			.tag-pill {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				padding: 0.1rem 0.45rem;
				border-radius: 4px;
				background: var(--color-surface-hover);
				color: var(--color-text-dim);
				border: 1px solid var(--color-border);
			}

			.tag-pill-highlight {
				background: var(--color-accent-surface);
				color: var(--color-accent);
				border-color: var(--color-accent);
			}

			.talk-meta {
				font-size: 0.82rem;
				font-family: var(--font-mono);
				color: var(--color-text-dim);
			}

			.talk-actions {
				display: flex;
				align-items: center;
				gap: 0.85rem;
				font-family: var(--font-mono);
				font-size: 0.82rem;
			}

			.talk-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
				color: var(--color-text-muted);
				opacity: 0.6;
				text-decoration: none;
				transition: opacity 0.15s ease, color 0.15s ease;
			}

			.talk-btn:hover {
				opacity: 1;
				color: var(--color-accent);
				text-decoration: none;
			}

			/* pseudoyu Projects Grid Style */
			.projects-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 1rem;
				margin-top: 1rem;
			}

			.project-item {
				padding: 1rem 1.15rem;
				border-radius: 8px;
				background: var(--color-surface);
				border: 1px solid var(--color-border);
				text-decoration: none;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 0.5rem;
				transition: border-color 0.15s ease, transform 0.15s ease;
			}

			.project-item:hover {
				border-color: var(--color-accent);
				transform: translateY(-2px);
				text-decoration: none;
			}

			.project-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.project-name {
				font-size: 1.05rem;
				font-weight: 600;
				color: var(--color-text-main);
			}

			.project-desc {
				font-size: 0.88rem;
				color: var(--color-text-dim);
				margin: 0;
				line-height: 1.5;
			}

			.project-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin-top: 0.25rem;
			}

			/* Posts List Style */
			.posts-list {
				list-style: none;
				padding: 0;
				margin: 1rem 0;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}

			.post-entry {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.5rem 0;
				border-bottom: 1px dashed var(--color-border);
			}

			.post-title {
				font-size: 1rem;
				font-weight: 500;
				color: var(--color-text-main);
				text-decoration: none;
			}

			.post-title:hover {
				color: var(--color-accent);
			}

			.post-date {
				font-family: var(--font-mono);
				font-size: 0.84rem;
				color: var(--color-text-dim);
				flex-shrink: 0;
			}

			/* Terminal command jump */
			.terminal-cd-jump {
				margin: 3.5rem 0 1.5rem 0;
				font-family: var(--font-mono);
				font-size: 0.95rem;
				color: var(--color-text-dim);
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.terminal-cd-link {
				color: var(--color-accent);
				text-decoration: underline;
				text-underline-offset: 4px;
				font-weight: 600;
			}

			@media (max-width: 640px) {
				.subnav-tabs {
					font-size: 1.3rem;
					gap: 1rem;
				}

				.author-name {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="content-wrapper">
				<!-- 顶部个人介绍 (pseudoyu 风格) -->
				<section class="intro-section">
					<h1 class="author-name">{SITE_TITLE}</h1>
					<div class="author-tagline">
						大模型算法工程师 · 聚焦模型训练、推理效率与评测分析
					</div>

					<p class="bio-paragraph">
						你好，我是 <strong>章坤 (ZK)</strong>，大模型算法工程师。关注大语言模型与多模态模型的训练优化（SFT、GRPO、蒸馏）、长音频推理与自动化评测闭环。
					</p>

					<p class="bio-paragraph">
						教育背景：<strong>清华大学</strong>（硕士研究生）· <strong>安徽大学</strong>（学士）。
					</p>

					<p class="bio-paragraph" style="font-size: 0.92rem; color: var(--color-text-dim);">
						你可以浏览我的 <a href="#projects">精选项目</a>，或者查看全部 <a href="/blog">技术博客文章</a>。欢迎通过 <a href="https://github.com/ruyishu" target="_blank" rel="noopener noreferrer">GitHub</a> 或邮件 <a href="mailto:kunzhang19970209@gmail.com" style="font-family: var(--font-mono); color: var(--color-text-main);">kunzhang19970209@gmail.com</a> 交流。
					</p>
				</section>

				<!-- 标志性大字切换 Tabs (Projects · Blog · Workbench · About) -->
				<nav class="subnav-tabs" aria-label="Page Sections">
					<a href="#projects" class="subnav-tab active">Projects</a>
					<a href="/blog" class="subnav-tab">Blog</a>
					<a href="/workbench" class="subnav-tab">Workbench</a>
					<a href="/about" class="subnav-tab">About</a>
				</nav>

				<!-- 核心板块 2: 精选项目 (遵循 pseudoyu.com/projects 现代网格卡片) -->
				<section id="projects" style="scroll-margin-top: 5rem; margin-top: 3.5rem;">
					<div class="watermark-container">
						<span class="watermark-text">Projects</span>
						<h2 class="section-anchor">Featured Projects</h2>
					</div>

					<div class="projects-grid">
						<a href="/workbench#projects" class="project-item">
							<div class="project-header">
								<span class="project-name">FastInfer-Engine</span>
								<span class="tag-pill tag-pill-highlight">C++20 / CUDA</span>
							</div>
							<p class="project-desc">
								面向大语言模型的高吞吐自研推理运行时，支持 FlashAttention 算子融合与虚拟分页 KV-Cache 内存池管理。
							</p>
							<div class="project-tags">
								<span class="tag-pill">P99 &lt; 8.2ms</span>
								<span class="tag-pill">TensorRT-LLM</span>
								<span class="tag-pill">FusedKernel</span>
							</div>
						</a>

						<a href="/workbench#projects" class="project-item">
							<div class="project-header">
								<span class="project-name">DistFlow-Scheduler</span>
								<span class="tag-pill tag-pill-highlight">Python / PyTorch</span>
							</div>
							<p class="project-desc">
								异构 GPU 集群分布式训练拓扑编排器。利用梯度通信与前向流水线智能重叠，压榨跨机 NVLink 带宽。
							</p>
							<div class="project-tags">
								<span class="tag-pill">Speedup 1.34x</span>
								<span class="tag-pill">NCCL</span>
								<span class="tag-pill">FaultTolerance</span>
							</div>
						</a>

						<a href="/workbench#projects" class="project-item">
							<div class="project-header">
								<span class="project-name">ruyishu.github.io</span>
								<span class="tag-pill tag-pill-highlight">Astro 7 / TS</span>
							</div>
							<p class="project-desc">
								当前静态技术博客与个人工作台，极简排版、零框架臃肿、双 Shiki 代码高亮与可收缩侧边栏。
							</p>
							<div class="project-tags">
								<span class="tag-pill">Pure Static</span>
								<span class="tag-pill">Zero-JS Main</span>
								<span class="tag-pill">Dark Mode</span>
							</div>
						</a>
					</div>
				</section>

				<!-- 核心板块 3: 最新撰写的博客文章 (pseudoyu 风格时间线列表) -->
				<section style="margin-top: 3.5rem;">
					<div class="watermark-container">
						<span class="watermark-text">Posts</span>
						<h2 class="section-anchor">Recent Posts</h2>
					</div>

					<ul class="posts-list">
						{
							posts.map((post) => (
								<li class="post-entry">
									<a href={`/blog/${post.id}/`} class="post-title">
										{post.data.title}
									</a>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))
						}
					</ul>

					<div style="margin-top: 1rem;">
						<a href="/blog" style="font-size: 0.9rem; font-family: var(--font-mono); color: var(--color-accent);">
							查看全部文章归档 →
						</a>
					</div>
				</section>

				<!-- pseudoyu 风格的终端引导跳转 (cd ./workbench) -->
				<div class="terminal-cd-jump">
					<span style="opacity: 0.5;">&gt;</span>
					<span>进入博主专属控制台：</span>
					<a href="/workbench" class="terminal-cd-link">cd ./workbench</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
