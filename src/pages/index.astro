---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { BENCH_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 4);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.content-wrapper {
				max-width: 48rem;
				margin: 0 auto;
			}

			/* Bio Section */
			.intro-section {
				margin-bottom: 2.5rem;
			}

			.author-name {
				font-size: 2.5rem;
				font-weight: 800;
				letter-spacing: -0.03em;
				margin: 0 0 0.5rem 0;
			}

			.author-tagline {
				font-size: 1.15rem;
				color: var(--color-text-muted);
				margin-bottom: 1.5rem;
				line-height: 1.6;
			}

			.bio-paragraph {
				font-size: 1rem;
				line-height: 1.8;
				color: var(--color-text-main);
				margin-bottom: 1rem;
			}

			/* pseudoyu style Subnav Tabs */
			.subnav-tabs {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 1.5rem;
				font-size: 1.6rem;
				font-weight: 700;
				letter-spacing: -0.02em;
				margin: 2rem 0 3rem 0;
				padding-bottom: 0.5rem;
			}

			.subnav-tab {
				color: var(--color-text-main);
				opacity: 0.25;
				text-decoration: none;
				transition: opacity 0.15s ease;
			}

			.subnav-tab:hover {
				opacity: 0.7;
				text-decoration: none;
			}

			.subnav-tab.active {
				opacity: 1;
				text-decoration: underline;
				text-underline-offset: 8px;
			}

			/* Posts List Style */
			.posts-list {
				list-style: none;
				padding: 0;
				margin: 1rem 0;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}

			.post-entry {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.5rem 0;
				border-bottom: 1px dashed var(--color-border);
			}

			.post-title {
				font-size: 1rem;
				font-weight: 500;
				color: var(--color-text-main);
				text-decoration: none;
			}

			.post-title:hover {
				color: var(--color-accent);
			}

			.post-date {
				font-family: var(--font-mono);
				font-size: 0.84rem;
				color: var(--color-text-dim);
				flex-shrink: 0;
			}

			/* Terminal command jump */
			.terminal-cd-jump {
				margin: 3.5rem 0 1.5rem 0;
				font-family: var(--font-mono);
				font-size: 0.95rem;
				color: var(--color-text-dim);
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.terminal-cd-link {
				color: var(--color-accent);
				text-decoration: underline;
				text-underline-offset: 4px;
				font-weight: 600;
			}

			@media (max-width: 640px) {
				.subnav-tabs {
					font-size: 1.3rem;
					gap: 1rem;
				}

				.author-name {
					font-size: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="content-wrapper">
				<!-- 顶部个人介绍 (pseudoyu 风格) -->
				<section class="intro-section">
					<h1 class="author-name">{SITE_TITLE}</h1>
					<div class="author-tagline">
						大模型算法工程师 · 聚焦模型训练、推理效率与评测分析
					</div>

					<p class="bio-paragraph">
						你好，我是 <strong>如意鼠</strong>，大模型算法工程师。关注大模型的训练优化（SFT、GRPO、蒸馏）、推理与自动化评测闭环。
					</p>

					<p class="bio-paragraph" style="font-size: 0.92rem; color: var(--color-text-dim);">
						你可以浏览我的 <a href="/blog">技术博客文章</a>，或者查看 <a href="/about">关于我</a>。欢迎通过 <a href="https://github.com/ruyishu" target="_blank" rel="noopener noreferrer">GitHub</a> 交流。
					</p>
				</section>

				<!-- 大字切换 Tabs (Posts · Workbench · About) -->
				<nav class="subnav-tabs" aria-label="Page Sections">
					<a href="/blog" class="subnav-tab active">Posts</a>
					<a href={BENCH_URL} class="subnav-tab">Bench</a>
					<a href="/about" class="subnav-tab">About</a>
				</nav>

				<!-- 最新博客文章 -->
				<section style="margin-top: 1.5rem;">
					<div class="watermark-container">
						<span class="watermark-text">Posts</span>
						<h2 class="section-anchor">Recent Posts</h2>
					</div>

					<ul class="posts-list">
						{
							posts.map((post) => (
								<li class="post-entry">
									<a href={`/blog/${post.id}/`} class="post-title">
										{post.data.title}
									</a>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))
						}
					</ul>

					<div style="margin-top: 1.25rem;">
						<a href="/blog" style="font-size: 0.9rem; font-family: var(--font-mono); color: var(--color-accent);">
							查看全部文章归档 →
						</a>
					</div>
				</section>
				<!-- pseudoyu 风格的终端引导跳转 (cd ./workbench) -->
				<div class="terminal-cd-jump">
					<span style="opacity: 0.5;">&gt;</span>
					<span>进入博主专属控制台：</span>
					<a href="/workbench" class="terminal-cd-link">cd ./workbench</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
