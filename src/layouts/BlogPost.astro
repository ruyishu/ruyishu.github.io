---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	hideDate?: boolean;
}

const { title, description, pubDate, updatedDate, heroImage, hideDate = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			.article-header {
				margin-bottom: 2rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid var(--color-border);
			}

			.article-title {
				margin: 0 0 0.75rem 0;
				font-size: 2.1rem;
				line-height: 1.3;
				letter-spacing: -0.02em;
			}

			.article-meta {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.75rem;
				color: var(--color-text-muted);
				font-size: 0.9rem;
			}

			.hero-image {
				margin-bottom: 2rem;
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 8px;
				border: 1px solid var(--color-border);
			}

			.last-updated {
				color: var(--color-text-dim);
				font-style: italic;
			}

			.prose {
				color: var(--color-text-main);
			}

			@media (max-width: 640px) {
				.article-title {
					font-size: 1.65rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="article-header">
					<h1 class="article-title">{title}</h1>
					{
						!hideDate && pubDate && (
							<div class="article-meta">
								<span class="pub-date">
									发布于 <FormattedDate date={pubDate} />
								</span>
								{updatedDate && (
									<span class="last-updated">
										（更新于 <FormattedDate date={updatedDate} />）
									</span>
								)}
							</div>
						)
					}
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script is:inline>
			// 正文图片已被限制在正文宽度内，点一下在新标签页看原图
			document.querySelectorAll('.prose img').forEach((img) => {
				img.addEventListener('click', () => window.open(img.currentSrc || img.src, '_blank', 'noopener'));
			});
		</script>

	</body>
</html>
