---
const stages = [
  { title: '任务定义与数据接入', checks: ['确定图像、问题与答案结构；按感知、OCR、图表、推理等任务归类。', '记录来源与样本 ID；定位任务补充参考区域及标注约定。'], output: '统一 schema · 来源可追溯' },
  { title: '图文质量与格式清洗', checks: ['检查损坏图片、分辨率、文本可读性与坐标范围。', '剔除图文不相关、缺失信息和格式异常样本；疑难项回查。'], output: '有效图文对 · 异常样本池' },
  { title: '去重与评测隔离', checks: ['结合来源 ID、文本相似度与图像指纹去除重复。', '按原始图像 / 文档分组划分数据，隔离近重复图及评测集。'], output: '独立数据划分 · 去重记录' },
  { title: '可验证性与标注审核', checks: ['规范答案匹配规则，检查多解、歧义和验证器误判。', '审核区域标注是否对应问题，处理无效框与多目标情况。'], output: '答案 / 区域标签 · 验证规则' },
  { title: '多次采样与难度诊断', checks: ['用候选策略多次 rollout，统计通过率、奖励分布与错误类型。', '区分定位失败、推理失败和标注问题，识别过易与过难样本。'], output: '难度画像 · 失败类型' },
  { title: '分层筛选与数据配比', checks: ['结合任务、难度、分辨率与来源配比，限制同质样本占比。', '复核可疑样本；困难样本保留用于诊断、课程或后续迭代。'], output: '训练候选集 · 采样权重' },
  { title: '版本固化与训练装载', checks: ['固化数据清单、标签、验证器版本和筛选记录。', '训练时按当前策略重新采样，以完整奖励结果进行 RL 更新。'], output: '可复现训练版本 · RLVR 输入' },
  { title: '训练监控与失败回流', checks: ['联合监测答案正确率、区域 IoU、奖励异常及固定基准表现。', '从训练来源补充或修订样本；评测题目与标签不回灌训练。'], output: '问题归因 → 下一轮数据迭代' },
];
---

<div class="wenxin-study">
  <section aria-labelledby="wenxin-data-title">
    <div class="study-heading"><span>01 / DATA</span><h4 id="wenxin-data-title">从原始图文到可验证的 RLVR 训练数据</h4></div>
    <p class="study-lead">围绕样本质量、奖励可信度与可学习性，将数据接入、质量控制、难度诊断和训练反馈串联为可迭代的数据流程。下图展开多模态 RLVR 数据筛选中的关键检查点与阶段产出。</p>
    <figure class="pipeline">
      <div class="pipeline-top"><strong>Multimodal RLVR · Data pipeline</strong><span>接入 → 质量控制 → 筛选 → 迭代</span></div>
      <ol class="pipeline-stages">
        {stages.map((stage, i) => (
          <li class={`stage stage-${i + 1}`} style={`grid-area:s${i + 1}`}>
            <div class="stage-title"><span>{String(i + 1).padStart(2, '0')}</span><h5>{stage.title}</h5></div>
            <ul>{stage.checks.map((check) => <li>{check}</li>)}</ul>
            <p class="stage-output"><b>产出</b>{stage.output}</p>
          </li>
        ))}
      </ol>
      <div class="data-contract"><b>单条记录</b><span>图像 · 问题 · 标准答案 · 参考区域（按任务） · 验证器 · 来源 · split · 版本</span></div>
      <figcaption>Figure 1 · 多模态 RLVR 数据工程流程示意：通过可追溯的质量控制与失败回流，持续迭代训练数据。</figcaption>
    </figure>
    <details class="sampling-note">
      <summary>离线筛选与训练时动态采样有什么区别？</summary>
      <p>离线筛选决定哪些样本质量合格、标签可验证；训练时的动态采样则依据当前策略的奖励分布选择有学习信号的题组。例如 DAPO 会跳过组内奖励无差异的题组并继续采样。这不等于永久删除所有答错的题目，也不等于只保留正确回答进行 RL 训练。</p>
      <p>公开方法参考：<a href="https://arxiv.org/abs/2501.12948" target="_blank" rel="noopener noreferrer">DeepSeek-R1</a> · <a href="https://arxiv.org/abs/2503.14476" target="_blank" rel="noopener noreferrer">DAPO</a>。</p>
    </details>
  </section>

  <section class="grounding-section" aria-labelledby="wenxin-grounding-title">
    <div class="study-heading"><span>02 / METHOD</span><h4 id="wenxin-grounding-title">先定位关键证据，再回答问题</h4></div>
    <p class="study-lead">当模型没有找到问题所指的区域时，后续推理缺少可靠的视觉依据。训练中显式加入区域定位步骤，并以 <strong>IoU reward</strong> 衡量预测框与参考框的重合程度，为“应该看哪里”提供可验证反馈。</p>
    <figure class="method-figure">
      <a href="/images/about/wenxin-iou-reward.svg" target="_blank" rel="noopener noreferrer" aria-label="放大查看文心 IoU 定位奖励方法图">
        <picture>
          <source media="(max-width: 600px)" srcset="/images/about/wenxin-iou-reward-narrow.svg" />
          <img src="/images/about/wenxin-iou-reward.svg" width="1080" height="500" loading="lazy" alt="问题指定图表中的 B 项。策略先输出关键区域预测框，再依据图像证据回答 42。训练时，预测框与参考框计算 IoU，答案与标准答案计算正确性，两种奖励共同用于 RLVR 更新；参考标注不作为推理输入。" />
        </picture>
      </a>
      <figcaption>Figure 2 · 问题驱动的视觉定位与 RLVR：以区域 IoU 监督关键证据定位，并与答案奖励联合优化。图表为机制示例，参考标注仅用于训练奖励。</figcaption>
    </figure>
    <div class="reward-equation" aria-label="定位奖励与答案奖励的示意公式">
      <span>r<sub>loc</sub> = IoU(B<sub>pred</sub>, B<sub>ref</sub>) = |B<sub>pred</sub> ∩ B<sub>ref</sub>| / |B<sub>pred</sub> ∪ B<sub>ref</sub>|</span>
      <strong>R = r<sub>answer</sub> + λ · r<sub>loc</sub></strong>
    </div>
    <p class="fine">λ 控制定位奖励的权重。推理时输入图像与问题，由模型自主定位关键证据并作答。</p>
  </section>
</div>

<style>
  .wenxin-study { min-width: 0; margin: 1.1rem 0 1.4rem; }
  .study-heading { display: flex; flex-wrap: wrap; gap: .35rem .8rem; align-items: baseline; margin-bottom: .65rem; }
  .study-heading > span { color: var(--color-accent); font: .7rem var(--font-mono); letter-spacing: .04em; }
  .study-heading h4 { font-size: 1.06rem; margin: 0; color: var(--color-text-main); }
  .study-lead { font-size: .88rem; line-height: 1.8; color: var(--color-text-muted); margin: .5rem 0 1rem; }
  .pipeline { margin: 0; padding: 1.15rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface); }
  .pipeline-top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .4rem; padding-bottom: 1rem; }
  .pipeline-top strong { font-size: .9rem; color: var(--color-text-main); }
  .pipeline-top > span { font-size: .72rem; color: var(--color-text-dim); }
  .pipeline-stages { display: grid; grid-template-columns: 1fr 1fr; grid-template-areas: 's1 s2' 's4 s3' 's5 s6' 's8 s7'; gap: 1.65rem 2rem; list-style: none; padding: 0; margin: 0; }
  .stage { position: relative; padding: .85rem 1rem .7rem; background: var(--color-bg, #fff); border: 1px solid var(--color-border); border-top: 2px solid var(--color-accent); border-radius: 3px; min-width: 0; }
  .stage::after { content: '→'; position: absolute; color: var(--color-accent); font-size: 1.15rem; right: -1.65rem; top: 43%; line-height: 1; }
  .stage-2::after, .stage-4::after, .stage-6::after { content: '↓'; top: auto; bottom: -1.45rem; right: 50%; }
  .stage-3::after, .stage-7::after { content: '←'; left: -1.65rem; right: auto; }
  .stage-8::after { display: none; }
  .stage-title { display: flex; gap: .6rem; align-items: baseline; }
  .stage-title > span { font: .8rem var(--font-mono); color: var(--color-accent); }
  .stage h5 { margin: 0; font-size: .88rem; color: var(--color-text-main); }
  .stage ul { padding-left: 1rem; margin: .55rem 0 .7rem; font-size: .77rem; line-height: 1.75; color: var(--color-text-muted); }
  .stage ul li + li { margin-top: .2rem; }
  .stage-output { border-top: 1px dashed var(--color-border); padding-top: .5rem; margin: 0; font-size: .71rem; color: var(--color-text-muted); }
  .stage-output b { margin-right: .5rem; color: var(--color-accent); font-weight: 600; }
  .data-contract { border-top: 1px solid var(--color-border); margin-top: 1rem; padding-top: .8rem; display: flex; gap: .5rem 1rem; flex-wrap: wrap; font-size: .73rem; line-height: 1.7; color: var(--color-text-muted); }
  .data-contract b { color: var(--color-text-main); }
  figcaption { margin: .8rem 0 0; font-size: .75rem; line-height: 1.7; color: var(--color-text-muted); }
  .sampling-note { font-size: .77rem; line-height: 1.75; margin: .8rem 0 0; color: var(--color-text-muted); }
  .sampling-note summary { cursor: pointer; color: var(--color-accent); }
  .sampling-note p { margin: .7rem 0; }
  .grounding-section { margin-top: 1.8rem; padding-top: 1.2rem; border-top: 1px solid var(--color-border); }
  .method-figure { margin: 1rem 0; }
  .method-figure a { display: block; border: 1px solid var(--color-border); border-radius: 6px; overflow: hidden; background: #fff; }
  .method-figure img { display: block; width: 100%; height: auto; }
  .reward-equation { display: flex; flex-wrap: wrap; gap: .8rem 1.4rem; padding: .8rem 1rem; border-left: 2px solid var(--color-accent); background: var(--color-surface); color: var(--color-text-main); font-size: .83rem; line-height: 1.8; overflow-wrap: anywhere; }
  .fine { font-size: .75rem; line-height: 1.7; color: var(--color-text-dim); margin: .7rem 0 0; }
  @media (max-width: 600px) {
    .pipeline { padding: .8rem; }
    .pipeline-stages { display: flex; flex-direction: column; gap: 1.65rem; }
    .stage::after { content: '↓'; left: 50%; right: auto; top: auto; bottom: -1.45rem; }
    .stage ul { font-size: .8rem; }
    .study-heading h4 { font-size: 1rem; }
  }
</style>
