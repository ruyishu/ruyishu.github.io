---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="nav-wrapper">
		<div class="brand">
			<a href="/" class="brand-avatar-link" title={SITE_TITLE}>
				<div class="brand-avatar">如意</div>
			</a>
		</div>

		<div class="nav-right">
			<div class="internal-links">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/blog">文章</HeaderLink>
				<HeaderLink href="/workbench">工作台</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
			</div>

			<div class="external-links">
				<a
					href="https://github.com/ruyishu"
					target="_blank"
					rel="noopener noreferrer"
					class="icon-link"
					title="GitHub"
					aria-label="GitHub"
				>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
					</svg>
				</a>

				<a
					href="/rss.xml"
					target="_blank"
					class="icon-link"
					title="RSS Feed"
					aria-label="RSS Feed"
				>
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M4 11a9 9 0 0 1 9 9"></path>
						<path d="M4 4a16 16 0 0 1 16 16"></path>
						<circle cx="5" cy="19" r="1"></circle>
					</svg>
				</a>

				<button
					id="theme-toggle"
					class="icon-link theme-btn"
					type="button"
					title="切换颜色模式"
					aria-label="切换颜色模式"
				>
					<svg class="sun-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
					<svg class="moon-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
				</button>
			</div>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const toggleBtn = document.getElementById('theme-toggle');
		if (!toggleBtn) return;
		toggleBtn.addEventListener('click', () => {
			const currentTheme = document.documentElement.getAttribute('data-theme') || 
				(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
			document.documentElement.setAttribute('data-theme', nextTheme);
			try {
				localStorage.setItem('theme', nextTheme);
			} catch (e) {}
		});
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-bg);
		opacity: 0.98;
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--color-border);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.nav-wrapper {
		max-width: 52rem;
		margin: 0 auto;
		padding: 0.75rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand-avatar {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--color-text-main);
		color: var(--color-bg);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.8rem;
		font-weight: 800;
		font-family: var(--font-mono);
		letter-spacing: -0.5px;
		transition: transform 0.2s ease;
	}

	.brand-avatar-link:hover .brand-avatar {
		transform: scale(1.08);
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.external-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border-left: 1px solid var(--color-border);
		padding-left: 1rem;
	}

	.icon-link {
		color: var(--color-text-muted);
		opacity: 0.65;
		transition: opacity 0.15s ease, color 0.15s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 2px;
	}

	.icon-link:hover {
		opacity: 1;
		color: var(--color-text-main);
	}

	/* Theme toggle logic */
	.sun-icon { display: none; }
	.moon-icon { display: block; }

	:global(html[data-theme="dark"]) .sun-icon { display: block; }
	:global(html[data-theme="dark"]) .moon-icon { display: none; }

	@media (prefers-color-scheme: dark) {
		:global(html:not([data-theme="light"])) .sun-icon { display: block; }
		:global(html:not([data-theme="light"])) .moon-icon { display: none; }
	}

	@media (max-width: 640px) {
		.nav-wrapper {
			padding: 0.5rem 1rem;
		}

		.external-links {
			padding-left: 0.5rem;
			gap: 0.5rem;
		}
	}
</style>
