---
// 论文 / 研究页：统一按 Motivation（图）→ Method（图）→ Results（指标 + 表）排版。
import type { ResearchStudy, ResultTable } from '../data/resume';

interface Props {
	study: ResearchStudy;
}

const { study } = Astro.props;
const { motivation, method, results } = study;

const isHighlighted = (table: ResultTable, rowIndex: number) =>
	table.highlight ? table.highlight.includes(rowIndex) : rowIndex === table.rows.length - 1;

---

<div class="rs">
	<section class="rs-sec" aria-labelledby={`${study.slug}-motivation`}>
		<div class="rs-heading"><span>01</span><h3 id={`${study.slug}-motivation`}>Motivation</h3></div>
		{motivation.text.map((p) => <p>{p}</p>)}
		{motivation.figure && (
			<figure class="rs-figure">
				<a href={motivation.figure.src} target="_blank" rel="noopener noreferrer" aria-label="放大查看动机图">
					<img src={motivation.figure.src} width={motivation.figure.width} height={motivation.figure.height} alt={motivation.figure.alt} loading="lazy" decoding="async" />
				</a>
				<figcaption>{motivation.figure.caption}</figcaption>
			</figure>
		)}
	</section>

	{method && (
		<section class="rs-sec" aria-labelledby={`${study.slug}-method`}>
			<div class="rs-heading"><span>02</span><h3 id={`${study.slug}-method`}>Method</h3></div>
			{method.figure && (
				<figure class="rs-figure">
					<a href={method.figure.src} target="_blank" rel="noopener noreferrer" aria-label="放大查看方法图">
						<img src={method.figure.src} width={method.figure.width} height={method.figure.height} alt={method.figure.alt} loading="lazy" decoding="async" />
					</a>
					<figcaption>{method.figure.caption}</figcaption>
				</figure>
			)}
			<ol class="rs-steps">
				{method.text.map((p) => <li>{p}</li>)}
			</ol>
		</section>
	)}

	<section class="rs-sec" aria-labelledby={`${study.slug}-results`}>
		<div class="rs-heading"><span>{method ? '03' : '02'}</span><h3 id={`${study.slug}-results`}>Results</h3></div>
		{results.text?.map((p) => <p>{p}</p>)}
		{results.metrics && (
			<div class="rs-metrics">
				{results.metrics.map((m) => (
					<div class="rs-metric">
						<span class="rs-metric-value">{m.value}</span>
						<span class="rs-metric-label">{m.label}</span>
					</div>
				))}
			</div>
		)}
		{results.tables.map((table) => (
			<div class="rs-table-wrap">
				<table class="rs-table" style={`min-width:${Math.max(28, table.cols.length * 5.2)}rem`}>
					{table.caption && <caption>{table.caption}</caption>}
					<thead>
						<tr>{table.cols.map((c) => <th>{c}</th>)}</tr>
					</thead>
					<tbody>
						{table.rows.map((row, i) => (
							<tr class={isHighlighted(table, i) ? 'rs-hl' : undefined}>
								{row.map((cell, j) => (j === 0 ? <td class="rs-rowhead">{cell}</td> : <td>{cell}</td>))}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		))}
		{results.notes?.map((n) => <p class="rs-note">{n}</p>)}
	</section>
</div>

<style>
	.rs { display: grid; gap: 1.5rem; min-width: 0; width: 100%; }
	.rs-sec { min-width: 0; padding-top: 1.1rem; border-top: 1px solid var(--color-border); }
	.rs-heading { display: flex; align-items: baseline; gap: .75rem; margin-bottom: .55rem; }
	.rs-heading > span { font: .72rem var(--font-mono); color: var(--color-accent); }
	.rs-heading h3 { font-size: 1.1rem; margin: 0; color: var(--color-text-main); }
	.rs-sec > p { font-size: .9rem; line-height: 1.8; color: var(--color-text-muted); margin: .45rem 0 .75rem; }
	.rs-figure { margin: 1rem 0 1.1rem; }
	.rs-figure a { display: block; border: 1px solid var(--color-border); border-radius: 6px; overflow: hidden; background: #fff; }
	.rs-figure img { display: block; width: 100%; height: auto; }
	.rs-figure figcaption { font-size: .76rem; line-height: 1.7; color: var(--color-text-muted); margin: .65rem 0 0; }
	.rs-steps { margin: .4rem 0 0; padding-left: 1.2rem; display: grid; gap: .45rem; }
	.rs-steps li { font-size: .87rem; line-height: 1.8; color: var(--color-text-muted); }
	.rs-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .7rem; margin: .8rem 0 1rem; }
	.rs-metric { border: 1px solid var(--color-border); border-radius: 8px; padding: .8rem .95rem; background: var(--color-surface); }
	.rs-metric-value { display: block; font-size: 1.3rem; font-weight: 800; letter-spacing: -.02em; color: var(--color-text-main); line-height: 1.25; }
	.rs-metric-label { display: block; margin-top: .3rem; font-size: .76rem; line-height: 1.5; color: var(--color-text-dim); }
	.rs-table-wrap { overflow-x: auto; margin: 1rem 0 .4rem; }
	.rs-table { width: 100%; border-collapse: collapse; font-size: .82rem; margin: 0; }
	.rs-table caption { padding: 0 0 .45rem; text-align: left; font-size: .78rem; line-height: 1.6; color: var(--color-text-dim); caption-side: top; }
	.rs-table thead th { padding: .55rem .6rem; background: var(--color-surface); border-bottom: 1px solid var(--color-border); text-align: right; font-size: .72rem; font-weight: 600; color: var(--color-text-dim); white-space: nowrap; }
	.rs-table tbody td { padding: .55rem .6rem; border-bottom: 1px dashed var(--color-border); text-align: right; font-variant-numeric: tabular-nums; color: var(--color-text-muted); white-space: nowrap; }
	.rs-table thead th { text-transform: none; letter-spacing: 0; font-family: inherit; }
	.rs-table thead th:first-child, .rs-table tbody td.rs-rowhead { text-align: left; }
	.rs-table tbody td.rs-rowhead { font-weight: 500; color: var(--color-text-main); }
	.rs-table tbody tr.rs-hl td { color: var(--color-accent); font-weight: 650; }
	.rs-sec > .rs-note { font-size: .76rem; color: var(--color-text-dim); margin-top: .6rem; }
	@media (max-width: 640px) {
		.rs-heading h3 { font-size: 1rem; }
	}
</style>
